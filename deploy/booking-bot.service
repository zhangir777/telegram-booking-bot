# Alternative to Docker: run with systemd.
# sudo cp deploy/booking-bot.service /etc/systemd/system/ && sudo systemctl enable --now booking-bot
[Unit]
Description=Telegram booking bot
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/home/bot/telegram-booking-bot
ExecStart=/home/bot/.local/bin/uv run --no-sync python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
